# Experimental HDMI/USB bring-up. Kernel is built separately.
TARGET_ARCH := arm
TARGET_ARCH_VARIANT := armv7-a-neon
TARGET_CPU_VARIANT := generic
TARGET_CPU_ABI := armeabi-v7a
TARGET_CPU_ABI2 := armeabi
TARGET_BOARD_PLATFORM := bcm2837
TARGET_BOOTLOADER_BOARD_NAME := zero2w
TARGET_NO_BOOTLOADER := true
TARGET_NO_KERNEL := true
TARGET_NO_RADIOIMAGE := true
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_SPARSE_EXT_DISABLED := true
BOARD_SYSTEMIMAGE_PARTITION_SIZE := 805306368
BOARD_USERDATAIMAGE_PARTITION_SIZE := 1073741824
BOARD_CACHEIMAGE_PARTITION_SIZE := 134217728
BOARD_CACHEIMAGE_FILE_SYSTEM_TYPE := ext4
BOARD_FLASH_BLOCK_SIZE := 4096
BOARD_USES_GENERIC_AUDIO := true
USE_CAMERA_STUB := true
# First milestone uses AOSP software GLES 1.x and CPU-rendered application UI.
USE_OPENGL_RENDERER := false
BUILD_EMULATOR_OPENGL := false
TARGET_RUNNING_WITHOUT_SYNC_FRAMEWORK := true
TARGET_SYSTEM_PROP += device/experimental/zero2w/system.prop
ADDITIONAL_DEFAULT_PROPERTIES += ro.adb.secure=1
BOARD_WPA_SUPPLICANT_DRIVER := NL80211
WPA_SUPPLICANT_VERSION := VER_0_8_X
BOARD_WPA_SUPPLICANT_PRIVATE_LIB := lib_driver_cmd_zero2w
BOARD_HAL_STATIC_LIBRARIES += libhealthd.zero2w

BOARD_HAVE_BLUETOOTH := true
BOARD_HAVE_BLUETOOTH_BCM := true
