import /init.zero2w.usb.rc

on fs
    mount_all /fstab.zero2w

on init
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor ondemand
    mkdir /storage 0755 root root
    mkdir /storage/sdcard0 0700 root root
    export EXTERNAL_STORAGE /storage/sdcard0
    symlink /storage/sdcard0 /sdcard
    symlink /storage/sdcard0 /mnt/sdcard

on post-fs-data
    mkdir /data/media 0770 media_rw media_rw
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/system/wpa_supplicant 0770 wifi wifi
    write /sys/module/firmware_class/parameters/path /system/etc/firmware
    insmod /system/lib/modules/cfg80211.ko
    insmod /system/lib/modules/brcmutil.ko
    insmod /system/lib/modules/brcmfmac.ko

service sdcard /system/bin/sdcard -u 1023 -g 1023 /data/media /storage/sdcard0
    class late_start

# USB role for this build is configured in init.zero2w.usb.rc and boot/config.txt.

service wpa_supplicant /system/bin/wpa_supplicant -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -e/data/misc/wifi/entropy.bin -g/data/system/wpa_supplicant/wlan0 -Gwifi
    class main
    user root
    group wifi inet keystore
    disabled
    oneshot

service dhcpcd_wlan0 /system/bin/dhcpcd -aABDKL
    class main
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -n
    class main
    disabled
    oneshot
